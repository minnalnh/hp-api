    "serviceRawFile": "# \"org\" ensures this Service is used with the correct Serverless Framework Access Key.\norg: minnalnh\n# \"service\" is the name of this project. This will also be added to your AWS resource names.\nservice: hp-api\n\nprovider:\n  name: aws\n  runtime: nodejs24.x\n  architecture: arm64\n  region: eu-north-1\n  iam:\n    role: arn:aws:iam::816435462993:role/BasicLambdaAccess\n\nfunctions:\n  ## CHARACTERS\n  getCharacters:\n    handler: functions/characters/getCharacters/index.handler\n    events:\n      - httpApi:\n          path: /characters\n          method: get\n  getCharacterById:\n    handler: functions/characters/getCharacterById/index.handler\n    events:\n      - httpApi:\n          path: /characters/{id}\n          method: get\n  createCharacter:\n    handler: functions/characters/createCharacter/index.handler\n    events:\n      - httpApi:\n          path: /characters\n          method: post\n  updateCharacters:\n    handler: functions/characters/updateCharacters/index.handler\n    events:\n      - httpApi:\n          path: /characters/{id}\n          method: put\n  deleteCharacter:\n    handler: functions/characters/deleteCharacter/index.handler\n    events:\n      - httpApi:\n          path: /characters/{id}\n          method: delete\n\n  ## HOUSES\n  getHouses:\n    handler: functions/houses/getHouses/index.handler\n    events:\n      - httpApi:\n          path: /houses\n          method: get\n  getHouseById:\n    handler: functions/houses/getHouseById/index.handler\n    events:\n      - httpApi:\n          path: /houses/{id}\n          method: get\n\n  ## SPELLS\n  getSpells:\n    handler: functions/spells/getSpells/index.handler\n    events:\n      - httpApi:\n          path: /spells\n          method: get\n  getSpellById:\n    handler: functions/spells/getSpellById/index.handler\n    events:\n      - httpApi:\n          path: /spells/{id}\n          method: get\n  login:\n    handler: functions/auth/login/index.handler\n    events:\n      - httpApi:\n          path: /auth/login\n          method: post\n\nresources:\n  Resources:\n    CharactersTable:\n      Type: AWS::DynamoDB::Table\n      Properties:\n        TableName: hp-characters\n        BillingMode: PAY_PER_REQUEST\n        AttributeDefinitions:\n          - AttributeName: id\n            AttributeType: S\n        KeySchema:\n          - AttributeName: id\n            KeyType: HASH\n",
